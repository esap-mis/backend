<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="5" author="thewyolar">
        <createTable tableName="medical_record" remarks="Записи в медицинской карте">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="doctor" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="record" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="medical_card_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="medical_record"
                baseColumnNames="medical_card_id"
                referencedTableName="medical_card"
                referencedColumnNames="id"
                constraintName="fk_medical_record_card"
                onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="medical_record"/>
        </rollback>
    </changeSet>

</databaseChangeLog>