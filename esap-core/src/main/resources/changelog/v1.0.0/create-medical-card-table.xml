<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="4" author="thewyolar">
        <createTable tableName="medical_card" remarks="Медицинская карта">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="medical_card"
                baseColumnNames="patient_id"
                referencedTableName="patients"
                referencedColumnNames="id"
                constraintName="fk_medical_card_patient"
                onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="medical_card"/>
        </rollback>
    </changeSet>

</databaseChangeLog>