<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="10" author="thewyolar">
        <createTable tableName="role_doctor" remarks="Связь врачей и ролей">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="doctor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="role_doctor"
                baseColumnNames="role_id"
                referencedTableName="role"
                referencedColumnNames="id"
                constraintName="fk_role_doctor_role"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="role_doctor"
                baseColumnNames="doctor_id"
                referencedTableName="doctors"
                referencedColumnNames="id"
                constraintName="fk_role_doctor_doctor"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="role_doctor"
                columnNames="role_id, doctor_id"
                constraintName="uk_role_doctor_pair"/>

        <rollback>
            <dropTable tableName="role"/>
        </rollback>
    </changeSet>

</databaseChangeLog>