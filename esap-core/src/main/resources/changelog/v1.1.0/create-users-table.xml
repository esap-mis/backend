<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="1" author="thewyolar">
        <createTable tableName="users" remarks="Таблица пользователей системы">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="login" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="clinic_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="gender" type="INTEGER">
                <constraints nullable="false" checkConstraint="gender &gt;= 1 AND gender &lt;= 2"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="users"
                columnNames="login"
                constraintName="uk_users_login"/>

        <addForeignKeyConstraint
                baseTableName="users"
                baseColumnNames="clinic_id"
                referencedTableName="clinics"
                referencedColumnNames="id"
                constraintName="fk_users_clinic"
                onDelete="RESTRICT"/>

        <rollback>
            <dropTable tableName="users"/>
        </rollback>
    </changeSet>

</databaseChangeLog>